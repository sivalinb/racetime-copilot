GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=racetime-copilot
RACETIME_MAX_CALLS_PER_JOB=32
RACETIME_DAILY_CALL_LIMIT=120
