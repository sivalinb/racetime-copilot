GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=racetime-copilot
# Use 1.0 for a controlled demo/eval; lower this for routine development.
LANGSMITH_TRACING_SAMPLING_RATE=1.0
RACETIME_MAX_CALLS_PER_JOB=32
RACETIME_DAILY_CALL_LIMIT=120
# Optional: persistent volume location. Default is .runtime/ in this project.
# RACETIME_DATA_DIR=/data
# Public deployment only:
# RACETIME_ALLOWED_EMAILS=you@example.com
# RACETIME_AUTH_MODE=oidc
# RACETIME_PUBLIC=true

# Optional separate evaluation judge; never used for video analysis.
NEBIUS_API_KEY=
NEBIUS_JUDGE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# One hosted tracer at a time: langsmith, braintrust, or none.
RACETIME_OBSERVABILITY=langsmith
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=racetime-copilot
BRAINTRUST_PROJECT_ID=
